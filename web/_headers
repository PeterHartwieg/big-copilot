# Every page and file. The CSP backs the privacy notice: scripts, styles,
# fonts, images and fetches come from this site only, except the game link,
# which reads the Big Copilot Link mod on the player's own loopback (any port:
# #link= can move it). Inline scripts and style attributes are part of the
# built page, so 'unsafe-inline' stays; Pyodide compiles WebAssembly in the
# worker ('wasm-unsafe-eval'). CSP cannot name an IPv6 literal, so a #link= on
# [::1] is refused; the mod listens on 127.0.0.1. tests/test_headers.py checks
# this block, and tests/csp.test.cjs boots Pyodide and the link under it.
/*
  Content-Security-Policy: default-src 'self'; script-src 'self' 'unsafe-inline' 'wasm-unsafe-eval'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self'; connect-src 'self' http://127.0.0.1:* http://localhost:*; worker-src 'self'; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'
  X-Frame-Options: DENY
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Strict-Transport-Security: max-age=31536000

/version.json
  Cache-Control: no-store

/
  Cache-Control: no-cache

/index.html
  Cache-Control: no-cache

# Pyodide's files sit under a versioned folder and never change in place.
/pyodide/*
  Cache-Control: public, max-age=31536000, immutable

/fonts/*
  Cache-Control: public, max-age=604800

# The worker fetches every file here with the build stamp (py/<file>?v=<stamp>),
# and all five are stamp inputs, so a changed file always has a new URL.
/py/*
  Cache-Control: public, max-age=31536000, immutable
