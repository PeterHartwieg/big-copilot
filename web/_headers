# Every page and file. The CSP backs the privacy notice: scripts, styles,
# fonts, images and fetches come from this site only, except the game link,
# which reads the Big Copilot Link mod on the player's own loopback (any port:
# #link= can move it). Inline scripts and style attributes are part of the
# built page, so 'unsafe-inline' stays; Pyodide compiles WebAssembly in the
# worker ('wasm-unsafe-eval'). CSP cannot name an IPv6 literal, so web/app.js
# ignores a #link= on [::1] and uses the default; the mod listens on
# 127.0.0.1. tests/test_headers.py checks this block, and tests/csp.test.cjs
# boots Pyodide and the link under it.
/*
  Content-Security-Policy: default-src 'self'; script-src 'self' 'unsafe-inline' 'wasm-unsafe-eval'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self'; connect-src 'self' http://127.0.0.1:* http://localhost:*; worker-src 'self'; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'
  X-Frame-Options: DENY
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Strict-Transport-Security: max-age=31536000

/version.json
  Cache-Control: no-store

/
  Cache-Control: no-cache

/index.html
  Cache-Control: no-cache

/translate/*
  Cache-Control: no-cache

/translations/*
  Cache-Control: no-cache

# Pyodide's files sit under a versioned folder and never change in place.
/pyodide/*
  Cache-Control: public, max-age=31536000, immutable

/fonts/*
  Cache-Control: public, max-age=604800

# Worker/Python/data and optimized hosted JS/CSS paths name their exact SHA-256
# bytes. Missing old paths fail instead of serving a newer release's content.
/assets/*
  Cache-Control: public, max-age=31536000, immutable

# Every page fetch of these paths carries ?v=<build stamp> (or, for the map
# background, ?v=<its SHA-256>), and each file is a stamp input, so new bytes
# always arrive under a new URL. _headers cannot see the query, so the bare
# paths are immutable too; the page never requests one. tests/test_headers.py
# holds each fetch to its stamp. Unlike /assets/*, these URLs name a release,
# not bytes: an old stamp fetched after a deploy gets the new bytes.
/app.js
  Cache-Control: public, max-age=31536000, immutable

/community.js
  Cache-Control: public, max-age=31536000, immutable

/community.css
  Cache-Control: public, max-age=31536000, immutable

/report.js
  Cache-Control: public, max-age=31536000, immutable

/report.css
  Cache-Control: public, max-age=31536000, immutable

/i18n/*
  Cache-Control: public, max-age=31536000, immutable

/names/*
  Cache-Control: public, max-age=31536000, immutable

/maps/*
  Cache-Control: public, max-age=31536000, immutable

/wiki-data.json
  Cache-Control: public, max-age=31536000, immutable

# Fixed paths remain for local development and are never immutable.
/py/*
  Cache-Control: no-store

/worker.js
  Cache-Control: no-store
