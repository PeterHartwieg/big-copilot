# Generated map metadata records exact SVG hashes; preserve bytes across hosts.
web/maps/*.svg -text
# Third-party runtime and font files ship byte for byte as released.
web/pyodide/** -text
web/fonts/** -text
# Payload snapshots are compared as text; keep them LF on every checkout.
tests/fixtures/payload_snapshot/** text eol=lf
# Companion fixtures and schema are shared byte for byte with their producers.
contracts/rlo/*.json text eol=lf
