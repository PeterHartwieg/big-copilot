# Save games and anything generated from them
*.hsg
market_history.json
dashboard.html

# Python
__pycache__/
*.pyc
.venv-map/

# Cloudflare and Node
.wrangler/
node_modules/
dist/

# OS
.DS_Store
web/test-*
watch.log
watch.err

# Local research notes, never published
research/

# Private map generation tools, recipes, tests, and investigation notes.
# Only the finished assets in web/maps/ belong in the repository.
mockup/maps/
tests/test_map_pipeline.py
docs/location-map-assets.md
docs/location-selector-scope.md

# Cloudflare Worker local secrets, never commit (.dev.vars.example stays tracked)
.dev.vars
.dev.vars.*
!.dev.vars.example
# The mod's compiled output and Unity's editor droppings; only sources are committed
mod/**/*.dll
mod/**/Library/
mod/**/obj/

# Design canvases the mockup/*/build_*.py generators write, top level and project/
# folders alike: rerun the generator to see them.
mockup/**/*.dc.html
mockup/**/canvas.json
mockup/*/project/
