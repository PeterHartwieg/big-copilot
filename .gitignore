# Save games and anything generated from them
*.hsg
*.bcsave
market_history.json
dashboard.html

# Python
__pycache__/
*.pyc
.venv-map/

# Cloudflare and Node
.wrangler/
node_modules
dist/

# OS
.DS_Store
web/test-*
watch.log
watch.err

# Bug report folders downloaded from R2 (docs/community-features.md): saves, never committed
reports/

# Local research notes, never published
research/

# Private map generation tools, recipes, tests, and investigation notes.
# Only the finished assets in web/maps/ belong in the repository.
mockup/maps/
tests/test_map_pipeline.py
docs/location-map-assets.md
docs/location-selector-scope.md

# Cloudflare Worker local secrets, never commit (.dev.vars.example stays tracked)
.dev.vars
.dev.vars.*
!.dev.vars.example
# The mod's compiled output and Unity's editor droppings; only sources are committed
mod/**/*.dll
mod/**/Library/
mod/**/obj/

# Design canvases the mockup/*/build_*.py generators write, top level and project/
# folders alike: rerun the generator to see them.
mockup/**/*.dc.html
mockup/**/canvas.json
mockup/*/project/

# The code-derived site, written by `python build_web.py --assemble` from the
# committed sources (npm run deploy and CI run it). The game-derived files
# under web/ (web/py/gametext.json, web/wiki-data.json, web/names/, the map
# assets and floor plans) stay committed.
/web/index.html
/web/version.json
/web/assets/
/web/sitemap.xml
/web/robots.txt
/web/wiki/
/web/i18n/
/web/py/ba_save.py
/web/py/ba_facts.py
/web/py/ba_dashboard.py
/web/py/ba_buildings.json
/web/py/ba_demand_curves.json
/web/py/ba_item_prices.json
/web/py/ba_store_rules.json

/web/translations/
/web/translate/
