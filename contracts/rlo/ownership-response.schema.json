{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "decision": {
      "enum": [
        "allowed",
        "conditional",
        "refused",
        "unknown"
      ]
    },
    "owner": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1024
    },
    "task": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1024
    },
    "reasons": {
      "type": "array",
      "maxItems": 10000,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 1024
      }
    },
    "effects": {
      "type": "array",
      "maxItems": 10000,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 1024
      }
    }
  },
  "required": [
    "schemaVersion",
    "decision",
    "owner",
    "task",
    "reasons",
    "effects"
  ],
  "additionalProperties": false
}
