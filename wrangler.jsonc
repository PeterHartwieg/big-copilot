{
  // The Worker in server/worker.mjs only handles /api/* (see run_worker_first);
  // every other request is served straight from the ./web assets folder. The
  // server code lives outside web/ on purpose: web/worker.js is the existing
  // in-browser Python worker and must stay independent of this backend.
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "big-copilot",
  "main": "server/worker.mjs",
  "compatibility_date": "2026-09-01",
  // Keep local request URLs and Origin aligned instead of rewriting to the
  // production custom domain; these settings apply only to `wrangler dev`.
  "dev": {
    "ip": "127.0.0.1",
    "port": 8789,
    "host": "127.0.0.1:8789",
    "upstream_protocol": "http"
  },
  // The page's own address. Custom domains: wrangler creates the DNS records and
  // the certificate itself, since the zone lives in the same Cloudflare account.
  "workers_dev": false,
  "routes": [
    { "pattern": "bigcopilot.com", "custom_domain": true },
    { "pattern": "www.bigcopilot.com", "custom_domain": true }
  ],
  "assets": {
    "binding": "ASSETS",
    "directory": "./web",
    "not_found_handling": "404-page",
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [
    {
      "binding": "COMMUNITY_DB",
      "database_name": "big-copilot-community",
      "database_id": "7631f7ae-78b3-4175-9844-7c55b823770d",
      "migrations_dir": "migrations"
    }
  ],
  // Best-effort per-IP guards for /api/*. Keys are HMACs of the client IP, so raw
  // IPs never reach D1 or responses. Not a global enforcement promise. Presence
  // heartbeats have their own budget (a real tab sends one every five minutes);
  // bug reports have a small one of their own, a burst guard and not a daily
  // cap (it counts per minute and per Cloudflare location); visitor suggestions
  // also have a separate small budget. Every other route
  // shares COMMUNITY_LIMITER.
  "ratelimits": [
    {
      "name": "SUGGEST_LIMITER",
      "namespace_id": "1004",
      "simple": { "limit": 3, "period": 60 }
    },
    {
      "name": "COMMUNITY_LIMITER",
      "namespace_id": "1001",
      "simple": { "limit": 120, "period": 60 }
    },
    {
      "name": "PRESENCE_LIMITER",
      "namespace_id": "1002",
      "simple": { "limit": 20, "period": 60 }
    },
    {
      "name": "REPORT_LIMITER",
      "namespace_id": "1003",
      "simple": { "limit": 3, "period": 60 }
    }
  ],
  // Bug reports (POST /api/report): the save and the private details, each
  // report in a folder of its own. The bucket lives in the EU jurisdiction, and
  // its lifecycle rule deletes every object after 30 days (set once with
  // `wrangler r2 bucket lifecycle add`; docs/community-features.md).
  "r2_buckets": [
    {
      "binding": "REPORTS",
      "bucket_name": "big-copilot-reports",
      "jurisdiction": "eu"
    }
  ],
  // Secrets, by name only: the values are set with `npx wrangler secret put`,
  // and .dev.vars.example has local samples. GITHUB_REPORT_TOKEN is a
  // fine-grained token with Issues read and write on this one repository.
  "secrets": {
    "required": ["COMMUNITY_IP_SECRET", "GITHUB_REPORT_TOKEN"]
  },
  // Daily cleanup of presence rows older than 24 hours, of votes for polls
  // no longer in server/features.json. Bounded report cleanup runs every minute
  // to preserve the two-day orphan retention promise across large backlogs.
  "triggers": {
    "crons": ["17 3 * * *", "* * * * *"]
  },
  // No per-request invocation logs or traces (URL, method, country): the
  // privacy notice promises none. The Worker's own console output, which is
  // only the bounded failure event, is kept for every request: head sampling
  // keeps or drops all of a request's log lines, so a rate below 1 would lose
  // most failure events (docs/community-features.md, "Failure diagnostics").
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1,
    "logs": { "invocation_logs": false },
    "traces": { "enabled": false }
  }
}
