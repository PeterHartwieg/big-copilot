{
  "_comment": "One markup rule, three validators: tools/translation_catalogue.py valid_text(), validateTranslation() in server/translations.mjs and ttCommunityValid() in web/i18n.js must agree on every case (tests/test_translation_catalogue.py, tests/i18n_community.test.cjs).",
  "rules": {
    "tags": {"allowed": ["n:"], "required": [["n:"]], "maxLength": 2000, "markup": ["<b>", "</b>", "<span class=\"ok\">", "</span>"]},
    "br": {"allowed": [], "required": [], "maxLength": 2000, "markup": ["<br>"]},
    "plain": {"allowed": ["n:"], "required": [["n:"]], "maxLength": 2000}
  },
  "valid": [
    ["tags", "<b>{n}</b> negozi <span class=\"ok\">pronti</span>"],
    ["tags", "<span class=\"ok\">pronti</span>: <b>{n}</b> negozi"],
    ["tags", "<b>{n} -> <span class=\"ok\">pronti</span></b>"],
    ["tags", "<b>L'attività \"migliore\"</b> & {n} <span class=\"ok\">sì</span>"],
    ["br", "chiusura<br>dom 20:00"],
    ["plain", "{n} -> {n}"],
    ["plain", "L'attività \"migliore\" & {n}"],
    ["tags", "＜b＞{n}＜/b＞ <b>negozi</b> <span class=\"ok\">pronti</span>"],
    ["plain", "{n} ＜img＞ AT&T"]
  ],
  "invalid": [
    ["tags", "{n} negozi pronti"],
    ["tags", "<b>{n}</b> negozi"],
    ["tags", "<b>{n}</b> <b>x</b> <span class=\"ok\">pronti</span>"],
    ["tags", "<b>{n}</b> <span class=\"bad\">pronti</span>"],
    ["tags", "<b>{n}</b> <span class='ok'>pronti</span>"],
    ["tags", "<b>{n}</b> <span class=\"ok\" onclick=\"alert(1)\">pronti</span>"],
    ["tags", "<B>{n}</B> <span class=\"ok\">pronti</span>"],
    ["tags", "<b>{n} <span class=\"ok\">pronti</b></span>"],
    ["tags", "</b>{n}<b> <span class=\"ok\">pronti</span>"],
    ["tags", "<b>{n}</b> <span class=\"ok\">pronti</span> <img src=x onerror=alert(1)>"],
    ["tags", "<b>{n}</b> <span class=\"ok\">pronti</span><script>alert(1)</script>"],
    ["tags", "<b>{n}</b> <span class=\"ok\">pronti</span> <!-- x -->"],
    ["tags", "<b>{n}</b> <span class=\"ok\">pronti</span> < 3"],
    ["tags", "<b>{n}</b> <span class=\"ok\">pronti</span><"],
    ["tags", "<b{n}</b> <span class=\"ok\">pronti</span>"],
    ["tags", "<b>{n}</b> <span class=\"ok\">pronti</span> &lt;img&gt;"],
    ["tags", "<b>{n}</b> <span class=\"ok\">pronti</span> &#60;img&#62;"],
    ["tags", "<b>{n}</b> <span class=\"ok\"><b>pronti</b></span>"],
    ["tags", "<b></b> <span class=\"ok\">pronti</span>"],
    ["br", "chiusura dom 20:00"],
    ["br", "chiusura<br/>dom 20:00"],
    ["plain", "<b>{n}</b>"],
    ["plain", "{n} <img src=x onerror=alert(1)>"],
    ["plain", "{n} < 3"],
    ["tags", "<b>{n}</b> <span class=\"ok\">pronti</span> <![CDATA[<img src=x onerror=alert(1)>]]>"],
    ["tags", "<b>{n}</b> <span class=\"ok\">pronti</span> &lt"],
    ["plain", "{n} &ltimg src=x&gt"],
    ["plain", "{n} &amp grazie"],
    ["plain", "{n}&nbsp;grazie"]
  ]
}
